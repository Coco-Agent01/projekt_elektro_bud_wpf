<Window x:Class="projekt_elektro_bud_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elektro-Bud Magazyn"
        Height="450"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0"
                   Text="Szukaj"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <!--Pole wyszukiwania-->
        <TextBox x:Name="szukaj"
                 Grid.Row="1"
                 Height="35"
                 Margin="0,0,0,15"
                 Padding="8,4"
                 FontSize="14"
                 BorderBrush="Black"
                 VerticalContentAlignment="Center"
                 TextChanged="szukaj_TextChanged"
                 ToolTip="Wpisz nazwę produktu lub kod EAN"/>

        <!--Tabela produktów-->
        <DataGrid x:Name="listaProduktow"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                
                <DataGridTextColumn Header="Nazwa produktu"
                                    Binding="{Binding Nazwa}"
                                    Width="2*"/>

                
                <DataGridTextColumn Header="EAN"
                                    Binding="{Binding EAN}"
                                    Width="2*"/>

                
                <DataGridTextColumn Header="S"
                                    Binding="{Binding Sektor}"
                                    Width="*"/>

                
                <DataGridTextColumn Header="R"
                                    Binding="{Binding Regal}"
                                    Width="*"/>

               
                <DataGridTextColumn Header="P"
                                    Binding="{Binding Polka}"
                                    Width="*"/>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>